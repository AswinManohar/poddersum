# PodderSum backend configuration.
# Copy to `.env` in the REPO ROOT (this directory). The backend loads <repo>/.env
# regardless of the working directory; real environment variables override it.
# Never commit `.env`.

# --- Runtime -----------------------------------------------------------------
# Optional. One of local | staging | production. Default: local. (M0)
APP_ENV=local

# --- LLM provider ------------------------------------------------------------
# Required. Google AI Studio key (https://aistudio.google.com/apikey). Used by the
# model gateway for summaries, chat and transcription. (M0)
GEMINI_API_KEY=your-gemini-api-key

# --- Database ----------------------------------------------------------------
# Optional when APP_ENV=local (defaults to the docker Postgres below on host port 5433);
# required in staging/production. Any postgres:// or postgresql[+driver]:// scheme is
# accepted and normalised (asyncpg for the API, psycopg3 for Alembic/LangGraph). (M0)
DATABASE_URL=postgresql+asyncpg://poddersum:poddersum@localhost:5433/poddersum

# --- HTTP --------------------------------------------------------------------
# Optional. Comma-separated browser origins allowed by CORS. Default: local Next.js. (M0)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LangSmith tracing (all optional; tracing is skipped when unset) ---------
# Get a key at https://smith.langchain.com -> Settings -> API Keys. (M0-S2)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=poddersum-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
